{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "buildCommand": "npm --prefix chirper install && npm --prefix chirper run build",
  "outputDirectory": "chirper/dist",
  "rewrites": [
    { "source": "/api/v2/(.*)", "destination": "/api/index.php" },
    { "source": "/api/(.*)", "destination": "/api/index.php" }
  ]
}